# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Google Sheets API
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_CLIENT_EMAIL=your_client_email_here
GOOGLE_SHEETS_PRIVATE_KEY=your_private_key_here

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Admin - required. There is no default; if this is unset the admin area is
# locked and every /api/admin route returns 401.
ADMIN_PASSWORD=<set-a-strong-password>

# Optional. Signing key for admin session cookies. Setting it lets you log every
# admin session out - rotate this value - without changing the password anyone
# types. Falls back to ADMIN_PASSWORD when unset.
ADMIN_SESSION_SECRET=

# Optional staff bypass for the additional-pass order-id check. Leave unset to
# disable the bypass entirely.
MASTER_ORDER_KEY=
