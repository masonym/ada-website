# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.env.test.local

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
*.local

# vercel
.vercel

# OpenNext / Cloudflare
/.open-next/
/.wrangler/
.dev.vars*
!.dev.vars.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Media lives in S3/CloudFront, not the repo. Fonts are the exception - they are
# imported by globals.css and the build needs them.
/public/*
!/public/fonts
!/public/fonts/**

# Bulk image input/output for the conversion scripts. The scripts themselves are
# code and ARE tracked - they used to be ignored along with their working
# directories, so `npm run process-images` and `npm run convert-images` pointed
# at files that were not in the repo.
src/scripts/input/
src/scripts/output/
src/scripts/speakers-output/

# Google service-account credentials used by the speaker import script.
scripts/credentials.json


